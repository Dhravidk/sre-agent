# Default lab needs no credentials, Docker, AWS account, or model calls.
PORT=3000
SRE_LAB_URL=http://127.0.0.1:3000
# For real Teams only: dedicated test app and tenant.
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
TEAMS_ALLOWED_CONVERSATIONS=
# Read-only connector checks are opt-in: pnpm connectors:check --live
GITLAB_BASE_URL=
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_MR_IID=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_ISSUE_KEY=
JIRA_API_VERSION=3
# classic uses /api/v2; grail uses platform DQL and OAuth.
DYNATRACE_MODE=classic
DYNATRACE_BASE_URL=
DYNATRACE_TOKEN=
DYNATRACE_PROBLEM_ID=
# Optional Eve model calls, separately invoked; never used by pnpm dev/test.
AI_GATEWAY_API_KEY=

# Database-backed SRE service (separate from the original auction lab).
SRE_CONFIG=config/sre.local.json
SRE_PORT=3001
SRE_HOST=127.0.0.1
SRE_SQLITE_PATH=.local/sre.sqlite
SRE_SERVICE_URL=http://127.0.0.1:3001
# Optional real local Postgres. Leave empty for SQLite.
DATABASE_URL=
# connected mode requires both. Generate separate random secrets (32+ chars).
SRE_API_TOKEN=
SRE_CAPABILITY_SECRET=
SRE_TEAMS_MODE=off
TEAMS_PORT=3978
# Teams install package: pnpm sre:teams:package. Uses CLIENT_ID for the bot.
TEAMS_APP_ID=
TEAMS_APP_WEBSITE_URL=
TEAMS_APP_PRIVACY_URL=
TEAMS_APP_TERMS_URL=
TEAMS_APP_SCOPES=personal,team,groupChat
# Set all only for a package requesting RSC message-read consent.
TEAMS_APP_MESSAGE_ACCESS=mentions
# Ally connected runtime: Claude Code CLI, authenticated by your approved setup.
# The connected example selects claude; local development remains offline rules.
SRE_CLAUDE_BIN=claude
# Optional Claude model/deployment alias; omit to use the configured CLI default.
SRE_CLAUDE_MODEL=
SRE_CLAUDE_EFFORT=medium
# Legacy Eve mode only; not required by the Claude runtime.
EVE_URL=http://127.0.0.1:2000
EVE_TOKEN=
# SRE_MODEL may override the model configured in agent/agent.ts.
GITHUB_READ_TOKEN=
GITHUB_ROLLBACK_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITLAB_READ_TOKEN=
GITLAB_ROLLBACK_TOKEN=
GITLAB_WEBHOOK_SECRET=
DYNATRACE_API_TOKEN=
DYNATRACE_OAUTH_TOKEN=
DYNATRACE_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=
SERVICENOW_OAUTH_TOKEN=
SERVICENOW_WEBHOOK_SECRET=
RELEASE_WEBHOOK_SECRET=
LOG_WEBHOOK_SECRET=
HEALTH_WEBHOOK_SECRET=
